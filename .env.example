# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by admin for privileged writes / storage uploads
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth
ADMIN_PASSWORD=admin123

# Public site URL (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://dienmaylocphatdat.vn

# Google Analytics 4 measurement ID. Leave empty to disable GA (local/dev).
NEXT_PUBLIC_GA_ID=

# Store contact is managed in Admin → Cấu hình (site_settings table).


# Cloudflare R2 (media storage)
NEXT_PUBLIC_MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
